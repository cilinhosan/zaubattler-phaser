# dist/_headers

# Security Headers (Apply to all)
/*
  X-Content-Type-Options: nosniff

# Default: Cache everything strongly (including root JS, CSS, etc.)
/*
  Cache-Control: public, max-age=31536000, immutable

# Override: Files that should NOT be strongly cached (force revalidation)
/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0
/asset-manifest.json
  Cache-Control: no-cache, must-revalidate, max-age=0

# Note: /assets/* rule is now redundant because /* covers it, but doesn't hurt to leave
# Hashed assets directory (strong caching - covered by /* above)
# /assets/*
#  Cache-Control: public, max-age=31536000, immutable