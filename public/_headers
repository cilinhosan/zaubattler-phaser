# dist/_headers

# Security Headers
/*
  X-Content-Type-Options: nosniff

# Files that should not be strongly cached
/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0
/asset-manifest.json
  Cache-Control: no-cache, must-revalidate, max-age=0

# Hashed assets directory (strong caching)
/assets/*
  Cache-Control: public, max-age=31536000, immutable