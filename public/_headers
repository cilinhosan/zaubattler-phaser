# Security Headers (Apply to all paths)
/*
  X-Content-Type-Options: nosniff

# Critical files that must not be cached aggressively by browsers or CDNs
/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0

/asset-manifest.json
  Cache-Control: no-cache, must-revalidate, max-age=0

# Hashed JavaScript bundles in the root directory
# Webpack output: [name].[contenthash].bundle.js
# This rule targets those files.
/*.bundle.js
  Cache-Control: public, max-age=31536000, immutable

# Hashed static assets (images, audio, fonts, etc.) under /assets/
# Webpack output: assets/[contenthash][ext][query]
/assets/*
  Cache-Control: public, max-age=31536000, immutable